/* Requires the Docker Pipeline plugin */
pipeline {
    agent any
    tools {
        go '1.22.4'
    }
    properties(
        [
            parameters(
                [
                    string
                    (
                        description: 'Example: "adarshravidixit@gmail.com"',
                        name: 'Email_sender'
                    ),
                    text
                    (
                        'Email_recipients'
                    ),
                    string
                    (
                        description: 'Example: "Subject: My special subject\\nThis is the body of my email"',
                        name: 'Email message'
                    ),
                    text
                    (
                        description: 'Example: "<hostname>,<port-number>"',
                        name: 'Email_server_configurations'
                    )
                ]
            )
        ]
    )
    stages {
        stage('version') {
            steps {
                sh 'go run helloworld.go'
            }
        }
    }
}