pipeline {
    agent any
    tools {
        go '1.22.4'
    }
    parameters {
        string(name: 'Email_sender', description: 'Example: "<fromAddress>"')
        string(name: 'Email_recipients', description: 'Example: "<toAddress1>,<oAddress2>,..."')
        string(name: 'Email_message', defaultValue: '"Service XYZ has planned maintenance on Saturday from 2pm till 5pm cet"', description: 'Example: "<This is the body of my email>"')
        string(name: 'Email_server_configurations', defaultValue: '"smtp.gmail.com,:587"', description: 'Example: "<hostname>,<port-number>"')
        }
    stages {
        stage('version') {
            steps {
                sh "go run emailScript.go ${params.Email_sender} ${params.Email_recipients} ${params.Email_message} ${params.Email_server_configurations}"
            }
        }
    }
}